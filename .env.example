# v0.1 is hard-locked to paper mode.
TRADER_MODE=paper
DATABASE_PATH=data/paper_trader.db
INITIAL_CASH_KRW=10000000
INITIAL_CASH_USD=10000
FEE_RATE=0.00015
SLIPPAGE_BPS=5
MAX_ORDER_AMOUNT_KRW=1000000
MAX_ORDER_AMOUNT_USD=1000
ENGINE_INTERVAL_SECONDS=2
AUTO_START=false

# Optional: enables read-only live prices from Toss Securities.
# Never commit real credentials.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
