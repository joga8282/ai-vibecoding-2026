# Paper trading stays enabled unless you change this explicitly.
TRADER_MODE=paper

# Live trading requires a separate database, account, token, symbol policy,
# successful account reconciliation, and manual arming through the API.
# Keep these commented until live readiness has been independently confirmed.
# TRADER_MODE=live
# LIVE_DATABASE_PATH=data/live_trader.db
# TOSS_ACCOUNT_SEQ=your_account_sequence
# LIVE_TRADING_ENABLED=true
# LIVE_REQUIRE_MANUAL_ARM=true
# LIVE_MAX_ORDER_AMOUNT_KRW=100000
# LIVE_MAX_TOTAL_EXPOSURE_KRW=500000
# Above KRW caps may be 0 to use account-equity and cash limits without fixed KRW ceilings.
# LIVE_MAX_TOTAL_EXPOSURE_RATIO=0.15
# Aggregate holdings plus pending buys are limited to 15% by default.
# LIVE_AUTO_MAX_TOTAL_EXPOSURE_RATIO=0.15
# Legacy default: split the aggregate automatic budget into five equal slots.
# LIVE_AUTO_ALLOCATION_MODE=equal_slots
# Per-buy sizing: 15% per new symbol, 75% aggregate holdings + pending buys, at most 5 symbols.
# To use this policy, replace BOTH aggregate ratio values above with 0.75.
# LIVE_AUTO_ALLOCATION_MODE=per_order
# LIVE_MAX_BUY_RATIO=0.15
# LIVE_MIN_CASH_RATIO=0
# Explicit 0.30 reserves at least 30% of pre-order KRW account equity as cash.
# Held valuations, remaining pending buys and estimated buy fees count against the other 70%.
# LIVE_AUTO_BUDGET_SPLIT=per_buy
# remaining_slots splits current uninvested budget across remaining places in the 5-symbol portfolio.
# Example: per_order + remaining_slots + min cash 0.30 + buy cap 1 + both exposure ratios 0.70.
# Set RECOMMENDED_TRADE_RATIO=0.70 for that policy; direct buys still use MANUAL_TRADE_RATIO.
# RECOMMENDED_TRADE_RATIO=0.15
# MANUAL_TRADE_RATIO=0.15
# Both ratio sliders are capped at LIVE_MAX_BUY_RATIO in per_order mode.
# LIVE_MAX_DAILY_LOSS_KRW=50000
# Daily loss blocks new and averaging buys by default. Explicit false disables only this restriction.
# LIVE_DAILY_LOSS_LIMIT_ENABLED=true
# Loss tracking, per-buy and aggregate limits, cash, reconciliation and manual arming remain active.
# LIVE_MAX_POSITION_LOSS_PERCENT=3
# LIVE_ALLOWED_SYMBOLS=005930,000660
# LIVE_SYMBOL_POLICY=allowlist
# LIVE_SYMBOL_POLICY=recommended permits fresh qualified recommendation buys and held-position exits.
# API_ACCESS_TOKEN=generate-a-long-random-secret

DATABASE_PATH=data/auto_trader.db
INITIAL_CASH_KRW=10000000
INITIAL_CASH_USD=10000
FEE_RATE=0.00015
SLIPPAGE_BPS=5
# Expected net profit after estimated buy/sell fees, sale tax (LIVE), and slippage.
# Set SWING_MIN_NET_PROFIT_PERCENT=10 for a 10% net target; the default remains 3%.
# Raising the target clears lower-target trailing state for open holdings.
# Arm trailing only above a trigger that meets the target; later protective exits can be below it.
SWING_MIN_NET_PROFIT_PERCENT=3
# Fixed stop is on by default; opting out leaves take-profit and armed trailing protection active.
SWING_STOP_LOSS_ENABLED=true
# One averaging attempt per holding cycle; no retry after rejection, cancellation, partial fill or uncertainty.
SWING_AVERAGING_ENABLED=false
SWING_AVERAGING_TRIGGER_PERCENT=15
# Default automatic buy windows: 09:00-10:00, 12:00-14:00 and 16:00-20:00 on weekdays.
# Explicit false checks new/averaging buys throughout the supported regular and after-market sessions.
SWING_BUY_WINDOW_LIMIT_ENABLED=true
# LIVE averaging requires per_order allocation, per-buy ratio and aggregate exposure limits.
# Its budget targets the initial held cost, includes estimated fees, and is capped by available funding.
# Existing holdings use their cost at the first check as the initial basis.
# LIVE uses a limit at the fresh ask, cancels and confirms unfilled remainders, and resets old trailing peaks after fills.
# 2026 KOSPI/KOSDAQ ordinary shares; exemptions require a different estimate.
LIVE_SELL_TAX_RATE=0.002
MAX_ORDER_AMOUNT_KRW=1000000
MAX_ORDER_AMOUNT_USD=1000
RECOMMENDED_TRADE_RATIO=0.15
MANUAL_TRADE_RATIO=0.15
ENGINE_INTERVAL_SECONDS=2
AUTO_START=false
TOSS_MARKET_DATA_ENABLED=true
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
