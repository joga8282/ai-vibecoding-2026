# 자동매매 모드: 현재 버전은 안전을 위해 paper만 지원합니다.
TRADER_MODE=paper

# 가상계좌 저장 위치와 초기자금
DATABASE_PATH=data/paper_trader.db
INITIAL_CASH_KRW=10000000
INITIAL_CASH_USD=10000

# 가상 체결 비용과 주문 한도
# FEE_RATE=0.00015는 0.015%, SLIPPAGE_BPS=5는 0.05%입니다.
FEE_RATE=0.00015
SLIPPAGE_BPS=5
MAX_ORDER_AMOUNT_KRW=1000000
MAX_ORDER_AMOUNT_USD=1000
# 계좌 평가금액 중 이번 추천 거래에 사용할 비율 (0.50 = 50%)
RECOMMENDED_TRADE_RATIO=0.50

# 거래 엔진 실행 주기(초)와 서버 시작 시 자동 실행 여부
ENGINE_INTERVAL_SECONDS=2
AUTO_START=false

# 선택 설정: 토스증권 현재가 조회에 사용합니다.
# 현재 버전에서는 시세만 조회하며 실제 주문은 실행하지 않습니다.
# 실제 발급값을 .env.example 또는 Git에 커밋하지 마세요.
TOSS_MARKET_DATA_ENABLED=true
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
